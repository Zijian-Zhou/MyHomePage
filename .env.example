# Optional Compose overrides. Copy this file to .env before changing values.
WEB_PORT=5000
DEBUG=True
SECRET_KEY=django-insecure-docker-development-only
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=
RABBITMQ_USER=homepage
RABBITMQ_PASSWORD=change-me
DEFAULT_SUPERADMIN_USERNAME=superadmin
DEFAULT_SUPERADMIN_EMAIL=admin@example.com
# Set to True when Nginx (or another reverse proxy) is in front of Django.
TRUST_X_FORWARDED_FOR=False
# Anomaly monitor (audit log "Anomaly"): attack payloads, probes, scanners, floods, 404 bursts, 500s.
# Rate rules (flood / 404 burst) need real client IPs, i.e. TRUST_X_FORWARDED_FOR=True behind Nginx.
SECURITY_MONITOR_ENABLED=True
SECURITY_FLOOD_PER_MINUTE=300
SECURITY_404_PER_MINUTE=30
